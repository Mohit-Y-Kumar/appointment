apiVersion: v1
kind: Secret
metadata:
  name: docnest-secret
type: Opaque
stringData:
  MONGO_URI: "mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority"
  JWT_SECRET: "replace_with_a_long_random_secret_at_least_32_chars"
  ADMIN_EMAIL: "admin@yourdomain.com"
  ADMIN_PASSWORD_HASH: "<bcrypt_hash_of_admin_password>"
  FRONTEND_URL: "https://docnest.example.com"
  APP_URL: "https://api.docnest.example.com"
  ALLOWED_ORIGINS: "https://docnest.example.com,https://www.docnest.example.com"
  EMAIL_USER: "noreply@yourdomain.com"
  EMAIL_PASS: "your_email_app_password"
  CLOUDINARY_API_KEY: "your_cloudinary_key"
  CLOUDINARY_API_SECRET: "your_cloudinary_secret"
  CLOUDINARY_CLOUD_NAME: "your_cloudinary_cloud_name"
  RAZORPAY_KEY_ID: "rzp_live_your_key_id"
  RAZORPAY_KEY_SECRET: "your_razorpay_secret"
  RAZORPAY_WEBHOOK_SECRET: "your_webhook_secret"
  GROQ_API_KEY: "your_groq_api_key"